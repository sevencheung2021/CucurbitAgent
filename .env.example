# CucurbitAgent — environment template
# Copy to .env and fill in your own values:   cp .env.example .env
# Never commit your real .env to git.

# ---------- LLM backend (OpenAI-compatible protocol) ----------
# Any OpenAI-compatible provider works: DeepSeek, Zhipu (GLM), OpenAI, vLLM, ...
ZHIPU_API_KEY=your_api_key_here
ZHIPU_BASE_URL=https://api.deepseek.com
ZHIPU_MODEL=deepseek-v3
# optional: force thinking on/off (disabled | enabled)
# CUAGENT_LLM_THINKING=disabled

# ---------- Science data root ----------
# The platform resolves all module databases relative to this root.
# Point it at your data/science/ directory (see data/README.md for layout).
CUAGENT_DATA_ROOT=/path/to/CucurbitAgent-data/science

# Optional fine-grained overrides (defaults are derived from CUAGENT_DATA_ROOT):
# CUAGENT_GENOME_DB_DIR=<root>/genes/Database_Outputs
# CUAGENT_LITERATURE_DB=<root>/literature/Cucurbit_Papers_v4.db
# CUAGENT_CHROMA_DB=<root>/literature/chroma_cucurbit_db_v4
# CUAGENT_EXPRESSION_DIR=<root>/expression
# CUAGENT_WEB_STRUCTURE=<root>/structures
# CUAGENT_GENOME_DATA_MODULE=<root>/downloads

# ---------- Embedding model for the literature module ----------
# CUAGENT_EMBED_MODEL=BAAI/bge-m3
# local path to a downloaded copy, if you run offline:
# CUAGENT_EMBED_MODEL_LOCAL=

# ---------- Security / rate limiting ----------
# Set a long random string; required for admin endpoints.
CUAGENT_ADMIN_TOKEN=change_me_to_a_long_random_string
# Comma-separated list of allowed browser origins (leave empty for local dev).
# CUAGENT_CORS_ORIGINS=https://your.domain
# CUAGENT_TRUSTED_PROXIES=127.0.0.1
# CUAGENT_IP_HASH_SALT=change_me

# Per-minute / per-day LLM quotas (defaults shown)
# CUAGENT_LLM_RATE_LIMIT_PER_MIN=10
# CUAGENT_LLM_RATE_LIMIT_PER_DAY=20
# CUAGENT_LLM_RATE_LIMIT_PER_USER_DAY=20
# CUAGENT_LLM_RATE_LIMIT_PER_IP_DAY=40
# CUAGENT_DOWNLOAD_RATE_LIMIT_PER_HOUR=40

# ---------- Email verification (optional) ----------
# Without SMTP configured, verification codes are written to the API log.
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# ---------- Misc ----------
# CUAGENT_ENV=development
# CUAGENT_ANALYTICS_RETENTION_DAYS=90
